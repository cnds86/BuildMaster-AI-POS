# ─── Database ───────────────────────────────────────────────────────────────
DB_PASSWORD=mhxpos_secret_change_in_prod

# PostgreSQL connection
DATABASE_URL=postgresql://mhxpos:mhxpos_secret_change_in_prod@localhost:5432/mhxpos_prod

# ─── Security ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_256bit_secret_in_prod
JWT_EXPIRES_IN=8h

# ─── AI Provider (multi-provider) ─────────────────────────────────────────────
# Supported: gemini | openai | anthropic | ollama | minimax | openrouter | deepseek
AI_PROVIDER=gemini

# Gemini (Google AI Studio)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Ollama (local LLM — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# MiniMax (https://platform.minimax.chat)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=MiniMax-Text-01

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3006
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5176
