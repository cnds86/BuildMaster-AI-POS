# ============================================================
# MHX-POS Production Secrets — DO NOT COMMIT
# Copy this file to `.env` and fill in real values.
# Example: cp .env.production.example .env
# ============================================================

# PostgreSQL — generate with: openssl rand -base64 24
POSTGRES_USER=mhxpos
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
POSTGRES_DB=mhxpos

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
JWT_EXPIRES_IN=8h

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5180

# Printer (optional — leave PRINTER_ENABLED=false if no printer)
PRINTER_HOST=localhost
PRINTER_PORT=9100
PRINTER_ENABLED=false
