# ============================================================
# MHX-POS Frontend Dockerfile
# Stage 1: Build with Bun + Vite
# Stage 2: Serve with nginx Alpine
# ============================================================

# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM oven/bun:1-alpine AS builder

ARG VITE_API_URL=/api
ARG VITE_WS_URL=/ws
ARG VITE_PUBLIC_URL=http://localhost:5176

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_PUBLIC_URL=$VITE_PUBLIC_URL

WORKDIR /app

# Install all dependencies (Vite + React plugins needed for build)
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

# Copy source — .dockerignore excludes node_modules, git, etc.
COPY . .

# Build the Vite bundle (outputs to ./dist)
RUN bun run build

# ── Stage 2: Serve ─────────────────────────────────────────────────────────
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy built static assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config (SPA routing + /api proxy + /ws proxy)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port (nginx inside container listens on this)
ENV PORT=5173
EXPOSE 5173

# Health check via nginx /health endpoint (returns 200 'ok')
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD wget -qO- http://localhost:5173/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
